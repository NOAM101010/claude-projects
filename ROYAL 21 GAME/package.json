{
  "name": "royal21",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ROYAL 21 — social casino game room (virtual chips only)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:engine": "esbuild scripts/engine.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/engine.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/engine.test.mjs",
    "test:slots": "esbuild scripts/slots.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/slots.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/slots.test.mjs",
    "test:audio": "esbuild scripts/audio.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/audio.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/audio.test.mjs",
    "test:poker": "esbuild scripts/poker.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/poker.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/poker.test.mjs",
    "test:roulette": "esbuild scripts/roulette.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/roulette.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/roulette.test.mjs",
    "test:minigames": "esbuild scripts/minigames.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/minigames.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/minigames.test.mjs",
    "test:baccarat": "esbuild scripts/baccarat.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/baccarat.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/baccarat.test.mjs",
    "test:social": "esbuild scripts/social.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/social.test.mjs --log-level=error --alias:@=./src && node node_modules/.cache/social.test.mjs",
    "test:all": "npm run test:engine && npm run test:slots && npm run test:audio && npm run test:poker && npm run test:roulette && npm run test:minigames && npm run test:baccarat && npm run test:social",
    "gen:seed": "node scripts/run-gen-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
