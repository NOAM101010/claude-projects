# GOLDEN ACE — online leaderboard (optional)
#
# Copy this file to ".env" and fill in your Supabase project's values to turn the
# leaderboard from local-only into a real online board shared across players.
# You can reuse an existing Supabase project (e.g. your Royal21 one).
#
# 1. In the Supabase dashboard: Project Settings → API
#      VITE_SUPABASE_URL      = the "Project URL"
#      VITE_SUPABASE_ANON_KEY = the "anon public" key
# 2. Open the SQL editor and run  supabase/leaderboard.sql  once.
# 3. Restart the dev server. The leaderboard panel will show "🟢 online".
#
# Without these, the game runs fine with a local leaderboard (AI rivals + you).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
