# ===== מסד נתונים =====
# מחרוזת חיבור ל-PostgreSQL. ב-Vercel נוצרת אוטומטית כשמחברים Postgres דרך טאב Storage.
# לפיתוח מקומי: Postgres מקומי או Prisma Postgres חינמי.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ===== התראות Push (Web Push / VAPID) =====
# מפתחות VAPID — מייצרים פעם אחת עם: npm run generate-vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# כתובת מייל ליצירת קשר, בפורמט mailto:
VAPID_CONTACT="mailto:you@example.com"

# ===== Cron =====
# סוד שמאמת שהקריאה ל-/api/scanner/cron הגיעה מ-Vercel Cron.
# אם לא מוגדר — הנתיב פתוח. מומלץ להגדיר בפרודקשן.
CRON_SECRET=""

# ===== אופציונלי =====
# סוד ל-webhook של TradingView. אם מוגדר, ה-URL חייב לכלול ?token=<הסוד>
# TRADINGVIEW_WEBHOOK_SECRET=""
